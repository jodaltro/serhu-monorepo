# ============================================================================
# SERHU Orchestrator - Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# Exemplo: cp .env.example .env

# ============================================================================
# MEMÓRIA: Qdrant (Vector Database)
# ============================================================================
# Qdrant armazena a memória arquival do Ser (embeddings de texto)
# Saiba mais: https://qdrant.tech/
#
# Exemplo local: http://localhost:6333
# Exemplo cloud: https://your-instance.cloud.qdrant.io

QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ============================================================================
# MEMÓRIA: Supabase (Relational Database)
# ============================================================================
# Supabase armazena a personalidade, histórico e metadados do Ser
# Saiba mais: https://supabase.com/
# 
# Acesse sua URL em: https://app.supabase.com/project/[seu-id]/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# ============================================================================
# LLM: OpenAI API (GPT-5.4)
# ============================================================================
# Necessário para usar:
#   - orch.chat(): Geração de respostas + extração automática de traços
#   - orch.sleep(): Semantização e crenças enriquecidas
#
# Obtenha sua chave em: https://platform.openai.com/account/api-keys
# Importante: Nunca compartilhe sua chave de API!

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5.4

# ============================================================================
# COMO USAR
# ============================================================================
#
# 1. Com LLM ativado:
#    from serhu_orchestrator.llm.openai_client import OpenAIClient
#    llm = OpenAIClient(api_key=os.environ["OPENAI_API_KEY"])
#    orch = Orchestrator(..., llm_client=llm)
#    response, context = orch.chat("Olá!")  # ← Automático!
#
# 2. Sem LLM (fallback):
#    orch = Orchestrator(...)  # sem llm_client
#    ctx = orch.process_message("user", "Olá!")  # ← Manual
#
# ============================================================================
